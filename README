To run:
c
python3 -m venv venv
source venv/bin/activate

chmod +x ./execute.sh

pip3 install pyserial pygame flask opencv-python numpy pyrealsense2 flask-socketio

for pure ui:
flask run

setting up startup script:
sudo nano /etc/systemd/system/clothbot.service

  GNU nano 7.2          /etc/systemd/system/clothbot.service
[Unit]
Description=ClothBot Server
After=NetworkManager.service network-online.target
Wants=network-online.target

[Service]
User=fulvex
WorkingDirectory=/home/fulvex/ClothBot
Environment=SDL_AUDIODRIVER=dummy

# 1. Systemd will automatically create /run/clothbot and grant ownership to 'Cl>
RuntimeDirectory=clothbot

# 2. Force the environment variable to point to that newly created directory
Environment=XDG_RUNTIME_DIR=/run/clothbot

ExecStart=/bin/bash /home/fulvex/ClothBot/execute.sh

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target


To read:
sudo systemctl status clothbot
journalctl -u clothbot -f
